{
  "expo": {
    "name": "GDG on Campus EPI",
    "slug": "gdg-on-campus-epi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gdgepi",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "supportsTablet": false,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "This app shares community resources and event materials with other members."
      }
    },
    "android": {
      "package": "com.gdgepi.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#F9F9FF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F9F9FF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow GDG on Campus EPI to scan attendee tickets at events."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1A73E8"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3a89381b-b52f-4731-acad-7af37906eb05"
      }
    }
  }
}
