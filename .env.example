# API mode
# EXPO_PUBLIC_API_MODE=production  → remote REST backend (default; set EXPO_PUBLIC_API_URL below)
# EXPO_PUBLIC_API_MODE=mock        → in-memory seed database (offline dev, no backend required)
EXPO_PUBLIC_API_MODE=production
EXPO_PUBLIC_API_URL=https://gdg-app.onrender.com/api/v1

# Analytics
# EXPO_PUBLIC_ANALYTICS_MODE=console   → dev console logging (default in dev)
# EXPO_PUBLIC_ANALYTICS_MODE=posthog  → PostHog events
EXPO_PUBLIC_ANALYTICS_MODE=console
EXPO_PUBLIC_POSTHOG_KEY=
# Google Sign-In (Android app). The Web OAuth client ID from Google Cloud Console —
# public, it is the ID-token audience the API verifies. Must match GOOGLE_CLIENT_IDS on the server.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Only for iOS builds:
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
