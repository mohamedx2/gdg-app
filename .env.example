# API mode
# EXPO_PUBLIC_API_MODE=mock        → in-memory seed database (default for dev, no backend required)
# EXPO_PUBLIC_API_MODE=production  → remote REST backend (set EXPO_PUBLIC_API_URL below)
EXPO_PUBLIC_API_MODE=mock
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1

# Analytics
# EXPO_PUBLIC_ANALYTICS_MODE=console   → dev console logging (default in dev)
# EXPO_PUBLIC_ANALYTICS_MODE=posthog  → PostHog events
EXPO_PUBLIC_ANALYTICS_MODE=console
EXPO_PUBLIC_POSTHOG_KEY=