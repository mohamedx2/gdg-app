# Supabase project credentials.
# Project Settings -> API -> Project URL and "service_role" secret.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Signing secret for the access tokens the API issues. Use a long random string.
JWT_SECRET=change-me-to-a-long-random-string

# Access token lifetime (seconds). Default 30 days.
JWT_EXPIRES_IN_SECONDS=2592000

# HTTP server port.
PORT=4000

# Comma-separated list of allowed CORS origins, or * for any.
CORS_ORIGIN=*

# Google Sign-In: the Web OAuth client ID(s) the app requests ID tokens for
# (Google Cloud Console -> APIs & Services -> Credentials). Comma-separated.
GOOGLE_CLIENT_IDS=YOUR-WEB-CLIENT-ID.apps.googleusercontent.com
